<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nur für die Aktualisierung der Indikator- und Sperrlisten. Der Scan
         selbst läuft vollständig offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Unverzichtbar für einen Scanner: ohne die Sicht auf alle Pakete gibt
        es nichts zu prüfen. Google stuft die Berechtigung als sensibel ein,
        erlaubt sie aber ausdrücklich für Virenschutz-Apps. Beim Sideload
        führt sie zu einer Play-Protect-Warnung; das ist erwartet und in der
        Store-Beschreibung erklärt.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Vordergrunddienst für den Netzfilter. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ohne diese Berechtigung lehnt Android seit Version 8 jede
         Deinstallations-Anfrage ab: der Dialog erscheint schlicht nicht. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:name=".SelfGuardApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SelfGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SelfGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".net.DnsFilterService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local dns filtering for ad and tracker blocking" />
        </service>
    </application>
</manifest>
